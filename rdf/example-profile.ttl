@base            <https://example.fairdatapoint.org/fdp-api/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prof:    <http://www.w3.org/ns/dx/prof/> .
@prefix role:    <http://www.w3.org/ns/dx/prof/role/> .

<profile/77aaad6a-0136-4c6e-88b9-07ffccd0ee4c>
  a prof:Profile ;
  dcterms:title "FAIR Data Point metadata profile"@en ;
  dcterms:description "Constraints on the metadata record of a FAIR Data Point, as defined by the FDP specification version 2.0."@en ;
  prof:isProfileOf <https://www.w3.org/TR/vocab-dcat-3/> ;
  prof:hasResource [
    a prof:ResourceDescriptor ;
    prof:hasRole role:validation ;
    prof:hasArtifact <profile/77aaad6a-0136-4c6e-88b9-07ffccd0ee4c/shacl> ;
    dcterms:conformsTo <https://www.w3.org/TR/shacl/> ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/turtle> ;
  ] , [
    a prof:ResourceDescriptor ;
    prof:hasRole role:guidance ;
    prof:hasArtifact <https://specs.fairdatapoint.org/v2.0/#fair-data-point-metadata> ;
    dcterms:format <https://www.iana.org/assignments/media-types/text/html> ;
  ] .
